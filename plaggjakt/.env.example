# Kopiera den här filen till .env och fyll i din nyckel.
# Nyckel skapar du på https://platform.claude.com (API Keys).
# Utan nyckel körs appen i demoläge med exempelsvar.
ANTHROPIC_API_KEY=

# Valfritt: byt AI-modell (standard är den billiga Claude Haiku 5.5)
# CLAUDE_MODEL=claude-haiku-5-5

# Valfritt: annan port än 3030
# PORT=3030
